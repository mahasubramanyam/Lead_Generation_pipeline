+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { sanitizeMetadata } from "../server.js";
+
+describe("Audit secret sanitization", () => {
+  it("redacts secret-like keys", () => {
+    const result = sanitizeMetadata({
+      api_key: "sk-secret-123",
+      password: "hunter2",
+      normal_field: "visible",
+      nested: { access_token: "tok-abc", safe: "ok" },
+    });
+    assert.equal(result.api_key, "[REDACTED]");
+    assert.equal(result.password, "[REDACTED]");
+    assert.equal(result.normal_field, "visible");
+    assert.equal(result.nested.access_token, "[REDACTED]");
+    assert.equal(result.nested.safe, "ok");
+  });
+
+  it("redacts keys containing sensitive substrings (case-insensitive)", () => {
+    const result = sanitizeMetadata({
+      API_KEY: "val",
+      Authorization: "Bearer xxx",
+      my_secret: "val",
+    });
+    assert.equal(result.API_KEY, "[REDACTED]");
+    assert.equal(result.Authorization, "[REDACTED]");
+    assert.equal(result.my_secret, "[REDACTED]");
+  });
+
+  it("preserves non-sensitive nested objects", () => {
+    const result = sanitizeMetadata({ user: { name: "Alice", email: "a@b.com" } });
+    assert.equal(result.user.name, "Alice");
+    assert.equal(result.user.email, "a@b.com");
+  });
+
+  it("handles null and undefined", () => {
+    assert.equal(sanitizeMetadata(null), null);
+    assert.equal(sanitizeMetadata(undefined), undefined);
+  });
+
+  it("handles arrays", () => {
+    const result = sanitizeMetadata([{ secret: "x" }, { safe: "y" }]);
+    assert.equal(result[0].secret, "[REDACTED]");
+    assert.equal(result[1].safe, "y");
+  });
+});
