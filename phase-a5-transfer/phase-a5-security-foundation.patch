+  assert.equal(r.status, 200, "should register user");
+  TOKEN = r.body.token;
+  TENANT_ID = r.body.user.tenant_id;
+});
+
+describe("Credential management", () => {
+  const credValue = "sk-test-1234567890abcdef";
+
+  it("creates an encrypted credential", async () => {
+    const { status, body } = await json(TOKEN, "POST", "/api/credentials", {
+      provider: "google_maps",
+      credential_type: "api_key",
+      credential_name: "Test API Key",
+      credential_value: credValue,
+    });
+    assert.equal(status, 200);
+    assert.ok(body.ok);
+    assert.equal(body.credential.provider, "google_maps");
+    assert.equal(body.credential.credential_type, "api_key");
+    assert.equal(body.credential.credential_name, "Test API Key");
+    // Never return ciphertext or plaintext
+    assert.equal(body.credential.ciphertext, undefined);
+    assert.equal(body.credential.iv, undefined);
+    assert.equal(body.credential.auth_tag, undefined);
+  });
+
+  it("rejects unsupported provider", async () => {
+    const { status } = await json(TOKEN, "POST", "/api/credentials", {
+      provider: "evil_provider",
+      credential_type: "api_key",
+      credential_value: "test",
+    });
+    assert.equal(status, 400);
+  });
+
+  it("lists credentials without exposing secrets", async () => {
+    const { status, body } = await json(TOKEN, "GET", "/api/credentials");
+    assert.equal(status, 200);
+    assert.ok(Array.isArray(body));
+    for (const c of body) {
+      assert.equal(c.ciphertext, undefined);
+      assert.equal(c.iv, undefined);
+      assert.equal(c.auth_tag, undefined);
+    }
+  });
+
+  it("rejects cross-tenant credential access", async () => {
+    // Create a credential as this tenant
+    await json(TOKEN, "POST", "/api/credentials", {
+      provider: "brreg",
+      credential_type: "api_key",
+      credential_value: "brreg-key",
+    });
+
+    // Try to access with a different tenant ID by manipulating the URL
+    // (The server enforces tenant_id from the JWT, so this tests server-side enforcement)
+    const { status } = await json(TOKEN, "GET", "/api/credentials/999999");
+    assert.equal(status, 404, "non-existent credential should be 404");
+  });
+
+  it("updates credential metadata", async () => {
+    const { status } = await json(TOKEN, "PATCH", "/api/credentials/1", {
+      credential_name: "Renamed Key",
+    });
+    assert.equal(status, 200);
+  });
+
+  it("deletes a credential", async () => {
+    const { status } = await json(TOKEN, "DELETE", "/api/credentials/1");
+    assert.equal(status, 200);
+  });
+});
