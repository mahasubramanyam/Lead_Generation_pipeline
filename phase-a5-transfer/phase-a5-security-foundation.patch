diff --git a/tests/encryption.test.js b/tests/encryption.test.js
new file mode 100644
index 0000000..80b2903
--- /dev/null
+++ b/tests/encryption.test.js
@@ -0,0 +1,78 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import {
+  encryptCredential,
+  decryptCredential,
+  deriveTenantKey,
+} from "../server.js";
+
+const TEST_KEY = Buffer.alloc(32, 0x42);
+const TENANT_ID = 1;
+
+describe("Credential encryption (AES-256-GCM)", () => {
+  it("encrypts and decrypts round-trip", async () => {
+    const plaintext = "super-secret-api-key-12345";
+    const encrypted = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    assert.ok(encrypted.ciphertext);
+    assert.ok(encrypted.iv);
+    assert.ok(encrypted.authTag);
+    const decrypted = decryptCredential(encrypted, TEST_KEY, TENANT_ID);
+    assert.equal(decrypted, plaintext);
+  });
+
+  it("produces different ciphertext for same plaintext (random IV)", async () => {
+    const plaintext = "same-plaintext";
+    const e1 = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    const e2 = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    assert.notEqual(e1.ciphertext, e2.ciphertext);
+    assert.notEqual(e1.iv, e2.iv);
+    // Both decrypt to the same plaintext
+    assert.equal(decryptCredential(e1, TEST_KEY, TENANT_ID), plaintext);
+    assert.equal(decryptCredential(e2, TEST_KEY, TENANT_ID), plaintext);
+  });
+
+  it("fails decryption with wrong key", async () => {
+    const plaintext = "secret";
+    const encrypted = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    const wrongKey = Buffer.alloc(32, 0x43);
+    assert.throws(() => decryptCredential(encrypted, wrongKey, TENANT_ID));
+  });
+
+  it("fails decryption with wrong tenant (AAD binding)", async () => {
+    const plaintext = "secret";
+    const encrypted = encryptCredential(plaintext, TEST_KEY, 1);
+    assert.throws(() => decryptCredential(encrypted, TEST_KEY, 2));
+  });
+
+  it("fails decryption with tampered ciphertext", async () => {
+    const plaintext = "secret";
+    const encrypted = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    const tampered = { ...encrypted, ciphertext: "AAAAAAAAAAAAAAAAAAAAAA==" };
+    assert.throws(() => decryptCredential(tampered, TEST_KEY, TENANT_ID));
+  });
+
+  it("fails decryption with tampered auth tag", async () => {
+    const plaintext = "secret";
+    const encrypted = encryptCredential(plaintext, TEST_KEY, TENANT_ID);
+    const tampered = { ...encrypted, authTag: "AAAAAAAAAAAAAAAAAAAAAA==" };
+    assert.throws(() => decryptCredential(tampered, TEST_KEY, TENANT_ID));
+  });
+
+  it("deriveTenantKey produces distinct keys per tenant", async () => {
+    const key1 = await deriveTenantKey(TEST_KEY, 1, 1);
+    const key2 = await deriveTenantKey(TEST_KEY, 2, 1);
+    assert.notEqual(Buffer.compare(key1, key2), 0);
+  });
+
+  it("deriveTenantKey produces distinct keys per version", async () => {
+    const key1 = await deriveTenantKey(TEST_KEY, 1, 1);
+    const key2 = await deriveTenantKey(TEST_KEY, 1, 2);
+    assert.notEqual(Buffer.compare(key1, key2), 0);
+  });
+
+  it("deriveTenantKey is deterministic for same inputs", async () => {
+    const key1 = await deriveTenantKey(TEST_KEY, 1, 1);
+    const key2 = await deriveTenantKey(TEST_KEY, 1, 1);
+    assert.equal(Buffer.compare(key1, key2), 0);
+  });
+});
