+// ─── Encryption Helpers (AES-256-GCM) ─────────────────────────────────
+const ENCRYPTION_ALGORITHM = "aes-256-gcm";
+const ENCRYPTION_IV_LENGTH = 12;
+const ENCRYPTION_KEY_LENGTH = 32;
+
+async function deriveTenantKey(masterKey, tenantId, keyVersion = 1) {
+  return Buffer.from(
+    hkdfSync(
+      "sha256",
+      masterKey,
+      Buffer.from(String(tenantId), "utf8"),
+      Buffer.from(`tenant-credential-key-v${keyVersion}`, "utf8"),
+      ENCRYPTION_KEY_LENGTH
+    )
+  );
+}
+
+function encryptCredential(plaintext, key, tenantId) {
+  const iv = randomBytes(ENCRYPTION_IV_LENGTH);
+  const cipher = createCipheriv(ENCRYPTION_ALGORITHM, key, iv);
+  cipher.setAAD(Buffer.from(String(tenantId), "utf8"));
+  const ciphertext = Buffer.concat([cipher.update(plaintext, "utf8"), cipher.final()]);
+  const authTag = cipher.getAuthTag();
+  return {
+    ciphertext: ciphertext.toString("base64"),
+    iv: iv.toString("base64"),
+    authTag: authTag.toString("base64"),
+  };
+}
+
+function decryptCredential(encrypted, key, tenantId) {
+  const ciphertext = Buffer.from(encrypted.ciphertext, "base64");
+  const iv = Buffer.from(encrypted.iv, "base64");
+  const authTag = Buffer.from(encrypted.authTag, "base64");
+  const decipher = createDecipheriv(ENCRYPTION_ALGORITHM, key, iv);
+  decipher.setAuthTag(authTag);
+  decipher.setAAD(Buffer.from(String(tenantId), "utf8"));
+  const plaintext = Buffer.concat([decipher.update(ciphertext), decipher.final()]);
+  return plaintext.toString("utf8");
+}
+
+async function ensureTenantEncryptionKey(pool, tenantId, keyVersion = 1) {
+  if (!ENCRYPTION_MASTER_KEY) {
+    throw new Error("ENCRYPTION_MASTER_KEY is not configured");
+  }
+  const derivedKey = deriveTenantKey(ENCRYPTION_MASTER_KEY, tenantId, keyVersion);
+  await pool.query(
+    "INSERT INTO encryption_keys (tenant_id, key_version, key_material, active) VALUES ($1, $2, $3, true) ON CONFLICT (tenant_id, key_version) DO UPDATE SET active = true, key_material = EXCLUDED.key_material, rotated_at = (NOW())",
+    [tenantId, keyVersion, derivedKey.toString("base64")]
+  );
+  return derivedKey;
+}
+
+async function getTenantEncryptionKey(pool, tenantId, keyVersion = 1) {
+  const { rows } = await pool.query(
+    "SELECT key_material FROM encryption_keys WHERE tenant_id = $1 AND key_version = $2 AND active = true",
+    [tenantId, keyVersion]
+  );
+  if (rows.length === 0) {
+    throw new Error(`No active encryption key found for tenant ${tenantId} version ${keyVersion}`);
+  }
+  return Buffer.from(rows[0].key_material, "base64");
+}
