+import { describe, it, before } from "node:test";
+import assert from "node:assert/strict";
+
+const BASE = "http://localhost:5000";
+const API = (path) => `${BASE}/api${path}`;
+
+let TOKEN = "";
+let TENANT_ID = 1;
+
+function json(token, method, path, body) {
+  const headers = { "Content-Type": "application/json" };
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  return fetch(API(path), {
+    method,
+    headers,
+    body: body ? JSON.stringify(body) : undefined,
+  }).then(async (r) => ({ status: r.status, body: await r.json().catch(() => null) }));
+}
+
+before(async () => {
+  const r = await json("", "POST", "/auth/register", {
+    username: `inv-test-${Date.now()}`,
+    password: "testpass123",
+  });
+  assert.equal(r.status, 200);
+  TOKEN = r.body.token;
+  TENANT_ID = r.body.user.tenant_id;
+});
+
+describe("Tenant invitations", () => {
+  it("owner can create an invitation", async () => {
+    const { status, body } = await json(TOKEN, "POST", `/api/tenants/${TENANT_ID}/invitations`, {
+      email: `invitee-${Date.now()}@example.com`,
+      role: "member",
+    });
+    assert.equal(status, 200);
+    assert.ok(body.ok);
+    assert.ok(body.invitation_token, "invitation token should be returned");
+    assert.equal(body.invitation.email, `invitee-${Date.now()}@example.com`);
+  });
+
+  it("rejects invitation to another tenant", async () => {
+    const { status } = await json(TOKEN, "POST", "/api/tenants/99999/invitations", {
+      email: "test@example.com",
+      role: "member",
+    });
+    assert.equal(status, 403);
+  });
+
+  it("rejects invalid role", async () => {
+    const { status } = await json(TOKEN, "POST", `/api/tenants/${TENANT_ID}/invitations`, {
+      email: "test@example.com",
+      role: "superadmin",
+    });
+    assert.equal(status, 400);
+  });
+
+  it("lists pending invitations", async () => {
+    const { status, body } = await json(TOKEN, "GET", `/api/tenants/${TENANT_ID}/invitations`);
+    assert.equal(status, 200);
+    assert.ok(Array.isArray(body));
+  });
+});
