+import { describe, it, before, after } from "node:test";
+import assert from "node:assert/strict";
+
+const BASE = "http://localhost:5000";
+const API = (path) => `${BASE}/api${path}`;
+
+let TOKEN_OWNER = "";
+let TOKEN_MEMBER = "";
+let TENANT_ID = 1;
+
+function json(token, method, path, body) {
+  const headers = { "Content-Type": "application/json" };
+  if (token) headers["Authorization"] = `Bearer ${token}`;
+  return fetch(API(path), {
+    method,
+    headers,
+    body: body ? JSON.stringify(body) : undefined,
+  }).then(async (r) => ({ status: r.status, body: await r.json().catch(() => null) }));
+}
+
+before(async () => {
+  const r1 = await json("", "POST", "/auth/register", {
+    username: `rbac-owner-${Date.now()}`,
+    password: "testpass123",
+  });
+  assert.equal(r1.status, 200);
+  TOKEN_OWNER = r1.body.token;
+  TENANT_ID = r1.body.user.tenant_id;
+
+  const r2 = await json("", "POST", "/auth/register", {
+    username: `rbac-member-${Date.now()}`,
+    password: "testpass123",
+  });
+  assert.equal(r2.status, 200);
+  TOKEN_MEMBER = r2.body.token;
+});
+
+describe("RBAC and membership", () => {
+  it("owner can list members", async () => {
+    const { status } = await json(TOKEN_OWNER, "GET", `/api/tenants/${TENANT_ID}/members`);
+    assert.equal(status, 200);
+  });
+
+  it("member cannot list members", async () => {
+    const { status } = await json(TOKEN_MEMBER, "GET", `/api/tenants/${TENANT_ID}/members`);
+    assert.equal(status, 403);
+  });
+
+  it("owner cannot access another tenant's members", async () => {
+    const { status } = await json(TOKEN_OWNER, "GET", "/api/tenants/99999/members");
+    assert.equal(status, 403);
+  });
+
+  it("rejects invalid role", async () => {
+    const { status } = await json(TOKEN_OWNER, "PATCH", `/api/tenants/${TENANT_ID}/members/1/role`, {
+      role: "superadmin",
+    });
+    assert.equal(status, 400);
+  });
+});
